rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mfm89317855@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'amount', 'status', 'rail']) &&
        data.id is string && data.id.size() <= 128 &&
        data.amount is number &&
        data.status is string && data.status.size() <= 64 &&
        data.rail is string && data.rail.size() <= 64;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'timestamp', 'agentName', 'actionTaken', 'targetEntityId', 'humanSignOffStatus']) &&
        data.id is string && data.id.size() <= 128 &&
        data.timestamp is string && data.timestamp.size() <= 64 &&
        data.agentName is string && data.agentName.size() <= 64 &&
        data.actionTaken is string && data.actionTaken.size() <= 512 &&
        data.targetEntityId is string && data.targetEntityId.size() <= 128 &&
        data.humanSignOffStatus is string && data.humanSignOffStatus.size() <= 64;
    }

    function isValidLedgerBreak(data) {
      return data.keys().hasAll(['id', 'discrepancy', 'rail', 'status']) &&
        data.id is string && data.id.size() <= 128 &&
        data.discrepancy is number &&
        data.rail is string && data.rail.size() <= 64 &&
        data.status is string && data.status.size() <= 64;
    }

    // Connection testing doc
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(transactionId) && isValidTransaction(incoming());
      allow update: if isSignedIn() && isValidId(transactionId) && isValidTransaction(incoming());
      allow delete: if isAdmin() && isValidId(transactionId);
    }

    // Supervisory Audit Logs (Immutable)
    match /audit_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false; // Strict immutability guarantee
    }

    // Ledger Breaks Collection
    match /ledger_breaks/{breakId} {
      allow get: if isSignedIn() && isValidId(breakId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(breakId) && isValidLedgerBreak(incoming());
      allow update: if isSignedIn() && isValidId(breakId) && isValidLedgerBreak(incoming());
      allow delete: if isAdmin() && isValidId(breakId);
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
